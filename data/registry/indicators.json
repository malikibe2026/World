  "code": "sex_ratio",
  "category": "population",
  "name_en": "Sex ratio",
  "name_ms": "Nisbah jantina",
  "unit": "males per 100 females",
  "format": "decimal",
  "decimals": 1,
  "source_id": "worldstat_derived",
