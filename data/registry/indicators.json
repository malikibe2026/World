  "unit": "km²",
  "format": "count",
  "decimals": 0,
  "source_id": "worldstat_derived",
  "inputs_source_id": "natural_earth",
  "quality": "DERIVED",
  "layer": false,
  "formula": "Geodesic area (WGS84) of the boundary polygon",
  "notes": "Approximation; official land/surface area is shown from FAO via World Bank when available."
