  "layer": true,
  "scale": "linear",
  "formula": "population_male / population_female × 100",
  "reference": "1 January"
 },
 {
  "code": "density",
  "category": "population",
  "name_en": "Population density",
  "name_ms": "Kepadatan penduduk",
  "unit": "persons per km²",
  "format": "decimal",
  "decimals": 1,
  "source_id": "worldstat_derived",
  "inputs_source_id": "un_wpp_2024",
  "quality": "DERIVED",
  "layer": true,
  "scale": "log",
  "formula": "population / area_geometry_km2 (total area incl. inland water, from Natural Earth 1:10m geometry)",
  "reference": "1 January",
  "notes": "Uses geometric total area, so it is lower than official density on land area for countries with large lakes. The World Bank land-area density (EN.POP.DNST) is shown alongside when available."
 },
 {
  "code": "area_geometry_km2",
  "category": "geography",
  "name_en": "Area (from boundary geometry)",
