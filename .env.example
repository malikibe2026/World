# Copy to .env.local and fill in. Never commit real values.
# Only VITE_* variables are exposed to the browser — put NO secrets in them.

# Optional Supabase (PostgreSQL + PostGIS) backend. Without it the app uses the static snapshot in /public/data.
VITE_SUPABASE_URL=
# The *anon / publishable* key only (safe for browsers; RLS restricts it to read-only).
VITE_SUPABASE_ANON_KEY=

# Optional edge proxy for official APIs that lack CORS (supabase/functions/data-proxy).
VITE_DATA_PROXY_URL=

# Optional basemap overrides (raster XYZ templates). Check each provider's terms before production use.
VITE_BASEMAP_STREET_URL=
VITE_BASEMAP_STREET_DARK_URL=
VITE_BASEMAP_SATELLITE_URL=
VITE_BASEMAP_TERRAIN_URL=
VITE_BASEMAP_ATTRIBUTION=

# Sub-path when hosting under a folder (e.g. GitHub Pages: /World/)
VITE_BASE=/

# ---- Server-side only (pipeline / loader). NEVER prefix with VITE_ ----
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=
